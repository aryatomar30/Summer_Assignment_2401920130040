class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        vector<int> v;
        int m = nums1.size();
        int n = nums2.size();

        for(int i=0; i<m; i++){
            int j = 0;
            for(int j=0; j<n; j++){
                if(nums1[i] == nums2[j]){
                    if(j == n-1) v.push_back(-1);
                    else{
                        // int k = j+1;
                        for(int k = j+1 ; k < n ; k++){
                            if(nums2[k] > nums2[j]) {
                                v.push_back(nums2[k]);
                                break;
                            }
                            else if(k == n-1 && (nums2[k] < nums2[j])) v.push_back(-1);    
                        }
                    }
                }
            }
        }
        return v;
    }
};
