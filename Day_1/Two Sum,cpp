
  class Solution {
public:
    vector<int> twoSum(vector<int>& arr, int target) {
        unordered_map<int, int> pos;

        for (int i = 0; i < arr.size(); i++) {
            int need = target - arr[i];

            if (pos.find(need) != pos.end()) {
                return {pos[need], i};
            }

            pos[arr[i]] = i;
        }

        return {};
    }
};   
