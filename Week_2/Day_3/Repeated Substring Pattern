class Solution {
public:
    bool repeatedSubstringPattern(string s) {
        int n = s.length();
        if(n==0) return false;

        vector<int>lps(n , 0);
        int length = 0;
        int i = 1;

        while(i < n){
            if(s[i] == s[length]) {
                length++;
                lps[i] = length;
                i++;
            }
            else{
                if(length != 0){
                    length = lps[length - 1];
                }
                else{
                    lps[i] = 0;
                    i++;
                }
            }
        } 

        int longest_prefix_suffix = lps[n - 1];
        return longest_prefix_suffix > 0 && n % (n - longest_prefix_suffix) == 0;
    

    }
};
