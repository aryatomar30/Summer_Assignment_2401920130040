class Solution {
public:
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        vector<vector<string>>ans; // step 1
        int n= strs.size();
        map<string, vector<string>>mp; //step 1
        
        for(int i=0; i<n; i++){
            string s= strs[i];  //step 2

            sort(s.begin(),s.end()); //step 2

            mp[s].push_back(strs[i]); //step 2
        }

        for(auto it: mp){
            ans.push_back(it.second); //step 3
        }

        return ans;
    }
};
