class Solution {
public:
    string longestPalindrome(string s) {
        int n = s.size();
        int maxlen = 0;
        string ans = "";

        for (int i = 0; i < n; i++) {
            // for the odd
            int l = i, r = i;
            while (l >= 0 && r <= n - 1 && s[l] == s[r]) {
                if (r - l + 1 > maxlen) {
                    maxlen = r - l + 1;
                    ans = s.substr(l, maxlen);
                }
                l--;
                r++;
            }

            // for the even
            l = i, r = i + 1;
            while (l >= 0 && r <= n - 1 && s[l] == s[r]) {
                if (r - l + 1 > maxlen) {
                    maxlen = r - l + 1;
                    ans = s.substr(l, maxlen);
                }
                l--;
                r++;
            }
        }

        return ans;
    }
};

// tc = O(N^2)
